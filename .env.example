# CLERK AUTHENTICATION CONFIGURATION
# Obtain your Publishable and Secret keys from the Clerk Dashboard: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls (Chat, Embeddings, Grounding).
# Injected at runtime by AI Studio environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB CONFIGURATION
# Connects to MongoDB Atlas or local MongoDB replica set for vector search.
# If not set, NexusIQ seamlessly runs on an embedded resilient MongoDB storage engine.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="nexusiq_enterprise"

# REDIS CONFIGURATION (for BullMQ background indexing queues)
REDIS_URL="redis://localhost:6379"

# SECURITY & AUTH
AUTH_SECRET="nexusiq-enterprise-jwt-super-secret-key-change-in-prod"
AUTH_TOKEN_EXPIRY="7d"

# AI PROVIDER SETTINGS
DEFAULT_CHAT_MODEL="gemini-3.8-flash"
DEFAULT_EMBEDDING_MODEL="gemini-embedding-2-preview"
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.65

# STORAGE ADAPTER (local or s3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
AWS_S3_BUCKET="nexusiq-enterprise-docs"
AWS_REGION="us-east-1"
